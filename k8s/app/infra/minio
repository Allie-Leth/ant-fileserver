.integration_template: &integration_job
  image: python:3.12-slim
  services:
    - name: minio/minio:RELEASE.2024-06-12T00-24-24Z
      alias: minio                         # hostname = http://minio:9000
      command: ["server", "/data", "--console-address", ":9001"]
    - name: minio/mc                       # client to create bucket
      alias: mc
  variables:
    MINIO_ROOT_USER:     minioadmin
    MINIO_ROOT_PASSWORD: minioadmin
    STORAGE_ENDPOINT:    http://minio:9000
    STORAGE_BUCKET:      firmware
    STORAGE_REGION:      us-east-1
    STORAGE_ACCESS_KEY_ID:  $MINIO_ROOT_USER
    STORAGE_SECRET_ACCESS_KEY: $MINIO_ROOT_PASSWORD
  before_script:
    # wait for MinIO to be up, make bucket only once
    - |
      for i in {1..20}; do
        curl -sSf http://minio:9000/minio/health/live && break
        sleep 1
      done
    - mc alias set local http://minio:9000 $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD
    - mc mb --ignore-existing local/${STORAGE_BUCKET}
    - pip install -r requirements.txt
