# Copy this file to secrets.env and fill in your values
# DO NOT commit secrets.env to git!

# MinIO credentials
STORAGE_ACCESS_KEY_ID=your-minio-access-key
STORAGE_SECRET_ACCESS_KEY=your-minio-secret-key

# JWT secret for token signing
JWT_SECRET_KEY=your-super-secret-jwt-key

# API key roles mapping (JSON format)
# Example: {"test-key": ["uploader", "admin"], "device-key": ["device"]}
API_KEY_ROLES={"test-key": ["uploader", "admin"]}